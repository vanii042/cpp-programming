#include <iostream>
#include <vector>
using namespace std;
int main() {
    int n, target;
    if (!(cin >> n) || n < 0 || n > 100000) return 1;
    vector<int> a(n);
    for (int &x : a) if (!(cin >> x)) return 1;
    cout << "Target: ";
    if (!(cin >> target)) return 1;
    for (int i = 0; i < n; ++i) if (a[i] == target) {
        cout << "Found at index " << i << '\n'; return 0;
    }
    cout << "Not found\n";
    return 0;
}
