#include <iostream>
#include <vector>
using namespace std;
int main() {
    int rows, cols;
    if (!(cin >> rows >> cols) || rows <= 0 || cols <= 0 || rows > 500 || cols > 500) return 1;
    vector<vector<int>> a(rows, vector<int>(cols));
    for (auto &row : a) for (int &x : row) if (!(cin >> x)) return 1;
    for (int j = 0; j < cols; ++j) {
        for (int i = 0; i < rows; ++i) cout << a[i][j] << ' ';
        cout << '\n';
    }
    return 0;
}
