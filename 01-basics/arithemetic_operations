#include <iostream>
using namespace std;
int main() {
    double a, b;
    cout << "Enter two numbers: ";
    if (!(cin >> a >> b)) return 1;
    cout << "Sum: " << a + b << "\nDifference: " << a - b
         << "\nProduct: " << a * b << '\n';
    if (b != 0) cout << "Quotient: " << a / b << '\n';
    else cout << "Quotient: undefined (division by zero)\n";
    return 0;
}
