#include <iostream>
using namespace std;
int main() {
    double a, b;
    char op;
    cout << "Enter expression (e.g. 12 + 4): ";
    if (!(cin >> a >> op >> b)) return 1;
    switch (op) {
        case '+': cout << a + b; break;
        case '-': cout << a - b; break;
        case '*': cout << a * b; break;
        case '/':
            if (b == 0) { cerr << "Cannot divide by zero.\n"; return 1; }
            cout << a / b; break;
        default: cerr << "Unsupported operator.\n"; return 1;
    }
    cout << '\n';
    return 0;
}
