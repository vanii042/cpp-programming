#include <iostream>
using namespace std;
int main() {
    int n;
    cout << "How many numbers? ";
    if (!(cin >> n) || n <= 0) return 1;
    double sum = 0, x;
    for (int i = 0; i < n; ++i) {
        if (!(cin >> x)) return 1;
        sum += x;
    }
    cout << "Average = " << sum / n << '\n';
    return 0;
}
