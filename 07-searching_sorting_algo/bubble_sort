#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int main() {
    int n;
    if (!(cin >> n) || n < 0 || n > 100000) return 1;
    vector<int> a(n);
    for (int &x : a) if (!(cin >> x)) return 1;
    for (int i = 0; i < n; ++i) {
        bool changed = false;
        for (int j = 0; j + 1 < n - i; ++j) if (a[j] > a[j + 1]) {
            swap(a[j], a[j + 1]); changed = true;
        }
        if (!changed) break;
    }
    for (int x : a) cout << x << ' ';
    cout << '\n';
    return 0;
}
