#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int partitionArray(vector<int> &a, int low, int high) {
    int pivot = a[high], i = low;
    for (int j = low; j < high; ++j) if (a[j] <= pivot) swap(a[i++], a[j]);
    swap(a[i], a[high]);
    return i;
}
void quickSort(vector<int> &a, int low, int high) {
    if (low >= high) return;
    int p = partitionArray(a, low, high);
    quickSort(a, low, p - 1); quickSort(a, p + 1, high);
}
int main() {
    int n;
    if (!(cin >> n) || n < 0 || n > 100000) return 1;
    vector<int> a(n);
    for (int &x : a) if (!(cin >> x)) return 1;
    if (n) quickSort(a, 0, n - 1);
    for (int x : a) cout << x << ' ';
    cout << '\n';
    return 0;
}
