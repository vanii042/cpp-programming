#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int main() {
    int n;
    if (!(cin >> n) || n < 0 || n > 100000) return 1;
    vector<int> a(n);
    for (int &x : a) if (!(cin >> x)) return 1;
    for (int i = 0; i < n; ++i) {
        int minIndex = i;
        for (int j = i + 1; j < n; ++j) if (a[j] < a[minIndex]) minIndex = j;
        swap(a[i], a[minIndex]);
    }
    for (int x : a) cout << x << ' ';
    cout << '\n';
    return 0;
}
