#include <iostream>
#include <vector>
#include <queue>
using namespace std;
int main() {
    int n, m;
    if (!(cin >> n >> m) || n <= 0 || m < 0 || n > 100000) return 1;
    vector<vector<int>> graph(n);
    for (int i = 0, u, v; i < m; ++i) {
        if (!(cin >> u >> v) || u < 0 || u >= n || v < 0 || v >= n) return 1;
        graph[u].push_back(v); graph[v].push_back(u);
    }
    int start;
    if (!(cin >> start) || start < 0 || start >= n) return 1;
    vector<bool> seen(n, false); queue<int> q;
    seen[start] = true; q.push(start);
    while (!q.empty()) {
        int u = q.front(); q.pop(); cout << u << ' ';
        for (int v : graph[u]) if (!seen[v]) { seen[v] = true; q.push(v); }
    }
    cout << '\n';
    return 0;
}
