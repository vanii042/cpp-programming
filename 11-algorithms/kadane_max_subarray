#include <iostream>
#include <vector>
#include <algorithm>
#include <limits>
using namespace std;
int main() {
    int n;
    if (!(cin >> n) || n <= 0 || n > 1000000) return 1;
    long long current = 0, best = numeric_limits<long long>::lowest();
    for (int i = 0; i < n; ++i) {
        long long x; if (!(cin >> x)) return 1;
        current = max(x, current + x);
        best = max(best, current);
    }
    cout << "Maximum subarray sum = " << best << '\n';
    return 0;
}
