#include <iostream>
#include <vector>
#include <queue>
#include <limits>
using namespace std;
int main() {
    int n, m;
    if (!(cin >> n >> m) || n <= 0 || m < 0 || n > 100000) return 1;
    vector<vector<pair<int, int>>> graph(n);
    for (int i = 0, u, v, w; i < m; ++i) {
        if (!(cin >> u >> v >> w) || u < 0 || u >= n || v < 0 || v >= n || w < 0) return 1;
        graph[u].push_back({v, w}); graph[v].push_back({u, w});
    }
    int source;
    if (!(cin >> source) || source < 0 || source >= n) return 1;
    const long long INF = numeric_limits<long long>::max() / 4;
    vector<long long> dist(n, INF);
    priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;
    dist[source] = 0; pq.push({0, source});
    while (!pq.empty()) {
        auto [d, u] = pq.top(); pq.pop();
        if (d != dist[u]) continue;
        for (auto [v, w] : graph[u]) if (d + w < dist[v]) {
            dist[v] = d + w; pq.push({dist[v], v});
        }
    }
    for (int i = 0; i < n; ++i)
        cout << source << " -> " << i << ": " << (dist[i] == INF ? -1 : dist[i]) << '\n';
    return 0;
}
