#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;
int main() {
    int n, capacity;
    if (!(cin >> n >> capacity) || n < 0 || capacity < 0 || n > 1000 || capacity > 100000) return 1;
    vector<int> weight(n), value(n);
    for (int &x : weight) if (!(cin >> x) || x < 0) return 1;
    for (int &x : value) if (!(cin >> x)) return 1;
    vector<long long> dp(capacity + 1, 0);
    for (int i = 0; i < n; ++i)
        for (int w = capacity; w >= weight[i]; --w)
            dp[w] = max(dp[w], dp[w - weight[i]] + value[i]);
    cout << "Maximum value = " << dp[capacity] << '\n';
    return 0;
}
