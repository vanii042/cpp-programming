#include <iostream>
#include <set>
using namespace std;
int main() {
    int n;
    if (!(cin >> n) || n < 0 || n > 100000) return 1;
    set<int> values;
    for (int i = 0, x; i < n; ++i) { if (!(cin >> x)) return 1; values.insert(x); }
    for (int x : values) cout << x << ' ';
    cout << '\n';
    return 0;
}
