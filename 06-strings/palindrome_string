#include <iostream>
#include <string>
#include <algorithm>
#include <cctype>
using namespace std;
int main() {
    string s, clean;
    cout << "Enter text: ";
    getline(cin, s);
    for (unsigned char c : s) if (isalnum(c)) clean += static_cast<char>(tolower(c));
    string rev = clean;
    reverse(rev.begin(), rev.end());
    cout << (clean == rev ? "Palindrome\n" : "Not a palindrome\n");
    return 0;
}
