#include <iostream>
#include <string>
#include <map>
using namespace std;
int main() {
    string s;
    cout << "Enter a line: ";
    getline(cin, s);
    map<char, int> freq;
    for (char c : s) ++freq[c];
    for (const auto &entry : freq)
        cout << "'" << (entry.first == ' ' ? '_' : entry.first) << "' : " << entry.second << '\n';
    return 0;
}
