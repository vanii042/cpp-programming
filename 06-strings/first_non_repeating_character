#include <iostream>
#include <string>
#include <unordered_map>
using namespace std;
int main() {
    string s;
    cout << "Enter text: ";
    getline(cin, s);
    unordered_map<char, int> freq;
    for (char c : s) ++freq[c];
    for (char c : s) if (freq[c] == 1) {
        cout << "First non-repeating character: " << c << '\n'; return 0;
    }
    cout << "No non-repeating character\n";
    return 0;
}
