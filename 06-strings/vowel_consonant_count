#include <iostream>
#include <string>
#include <cctype>
using namespace std;
int main() {
    string s;
    cout << "Enter a line: ";
    getline(cin, s);
    int vowels = 0, consonants = 0;
    for (unsigned char c : s) if (isalpha(c)) {
        char ch = static_cast<char>(tolower(c));
        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') ++vowels;
        else ++consonants;
    }
    cout << "Vowels = " << vowels << "\nConsonants = " << consonants << '\n';
    return 0;
}
