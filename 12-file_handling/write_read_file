#include <iostream>
#include <fstream>
#include <string>
using namespace std;
int main() {
    const string filename = "sample.txt";
    {
        ofstream out(filename);
        if (!out) { cerr << "Could not open file for writing.\n"; return 1; }
        out << "C++ file handling example\n";
        out << "This line was written by the program.\n";
    }
    ifstream in(filename);
    if (!in) { cerr << "Could not open file for reading.\n"; return 1; }
    string line;
    while (getline(in, line)) cout << line << '\n';
    return 0;
}
