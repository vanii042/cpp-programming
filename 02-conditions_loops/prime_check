#include <iostream>
using namespace std;
int main() {
    long long n;
    cout << "Enter an integer: ";
    if (!(cin >> n)) return 1;
    bool prime = n >= 2;
    for (long long i = 2; prime && i <= n / i; ++i)
        if (n % i == 0) prime = false;
    cout << (prime ? "Prime\n" : "Not prime\n");
    return 0;
}
