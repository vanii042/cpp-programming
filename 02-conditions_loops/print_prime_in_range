#include <iostream>
using namespace std;
bool isPrime(int n) {
    if (n < 2) return false;
    for (int i = 2; i <= n / i; ++i) if (n % i == 0) return false;
    return true;
}
int main() {
    int low, high;
    cout << "Enter range (low high): ";
    if (!(cin >> low >> high) || low > high) return 1;
    for (int n = low; n <= high; ++n) if (isPrime(n)) cout << n << ' ';
    cout << '\n';
    return 0;
}
