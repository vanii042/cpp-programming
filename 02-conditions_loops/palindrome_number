#include <iostream>
#include <climits>
using namespace std;
int main() {
    long long n;
    cout << "Enter a non-negative integer: ";
    if (!(cin >> n) || n < 0) return 1;
    long long original = n, reversed = 0;
    while (n > 0) {
        int digit = static_cast<int>(n % 10);
        if (reversed > (LLONG_MAX - digit) / 10) {
            cerr << "Number is too large to reverse safely.\n";
            return 1;
        }
        reversed = reversed * 10 + digit;
        n /= 10;
    }
    cout << (original == reversed ? "Palindrome\n" : "Not a palindrome\n");
    return 0;
}
