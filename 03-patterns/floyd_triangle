#include <iostream>
using namespace std;
int main() {
    int rows, value = 1;
    cout << "Rows: ";
    if (!(cin >> rows) || rows < 1 || rows > 100) return 1;
    for (int i = 1; i <= rows; ++i) {
        for (int j = 1; j <= i; ++j) cout << value++ << ' ';
        cout << '\n';
    }
    return 0;
}
