#include <iostream>
using namespace std;
int main() {
    long long n;
    cout << "Enter an integer: ";
    if (!(cin >> n)) return 1;
    if (n < 0) n = -n;
    int sum = 0;
    while (n > 0) { sum += static_cast<int>(n % 10); n /= 10; }
    cout << "Sum of digits = " << sum << '\n';
    return 0;
}
