#include <iostream>
using namespace std;
unsigned long long fibonacci(int n) {
    if (n <= 1) return n;
    return fibonacci(n - 1) + fibonacci(n - 2);
}
int main() {
    int n;
    cout << "Enter index (0-40): ";
    if (!(cin >> n) || n < 0 || n > 40) return 1;
    cout << fibonacci(n) << '\n';
    return 0;
}
