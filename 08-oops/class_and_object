#include <iostream>
#include <string>
using namespace std;
class Student {
    string name;
    int roll;
public:
    Student(string n, int r) : name(move(n)), roll(r) {}
    void display() const { cout << "Name: " << name << "\nRoll: " << roll << '\n'; }
};
int main() {
    string name;
    int roll;
    cout << "Enter student name: ";
    getline(cin, name);
    cout << "Enter roll number: ";
    if (!(cin >> roll)) return 1;
    Student student(name, roll);
    student.display();
    return 0;
}
