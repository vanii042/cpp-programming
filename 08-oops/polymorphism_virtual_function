#include <iostream>
using namespace std;
class Shape {
public:
    virtual void draw() const { cout << "Drawing a shape\n"; }
    virtual ~Shape() = default;
};
class Circle : public Shape {
public:
    void draw() const override { cout << "Drawing a circle\n"; }
};
int main() {
    Circle circle;
    Shape *shape = &circle;
    shape->draw();
    return 0;
}
