#include <iostream>
using namespace std;
struct Node {
    int key;
    Node *left, *right;
    explicit Node(int value) : key(value), left(nullptr), right(nullptr) {}
};
Node* insert(Node *root, int key) {
    if (!root) return new Node(key);
    if (key < root->key) root->left = insert(root->left, key);
    else if (key > root->key) root->right = insert(root->right, key);
    return root;
}
void inorder(Node *root) {
    if (!root) return;
    inorder(root->left); cout << root->key << ' '; inorder(root->right);
}
void destroy(Node *root) {
    if (!root) return;
    destroy(root->left); destroy(root->right); delete root;
}
int main() {
    Node *root = nullptr;
    for (int x : {50, 30, 70, 20, 40, 60, 80}) root = insert(root, x);
    cout << "Inorder traversal: "; inorder(root); cout << '\n';
    destroy(root);
    return 0;
}
